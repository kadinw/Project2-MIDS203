ggplot(filtered_occ_data, aes(x = Predicted, y = Quality.of.Sleep)) +
geom_violin(fill = "lightgreen", alpha = 0.5) +
geom_jitter(width = 0.2, height = 0, alpha = 0.4, color = "blue") +
labs(
title = "Distribution of Sleep Quality by Predicted Occupation",
x = "Predicted Occupation",
y = "Reported Sleep Quality"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
new_data <- expand.grid(
Sleep.Duration = mean(filtered_occ_data$Sleep.Duration),
Quality.of.Sleep = seq(1, 10, length.out = 100),
Stress.Level = mean(filtered_occ_data$Stress.Level)
)
probs <- predict(model_filtered, newdata = new_data, type = "probs")
prob_df <- cbind(new_data, probs)
long_probs <- pivot_longer(prob_df,
cols = starts_with("Doctor"):last_col(),
names_to = "Occupation",
values_to = "Probability")
# Plot
ggplot(long_probs, aes(x = Quality.of.Sleep, y = Probability, color = Occupation)) +
geom_line(size = 1.2) +
labs(
title = "Predicted Probability of Occupation by Sleep Quality",
x = "Sleep Quality (1 = Poor, 10 = Excellent)",
y = "Predicted Probability"
) +
theme_minimal()
#| fig-cap: Synthetic data showing a hypothetical relationship between Earnings, Age, and Education. An increasing trend can be seen with decreasing slope for higher ages.
#| fig-width: 4
#| fig-pos: t
#| label: fig-dist
data <- data.frame(
age = rpois(n = 300, lambda = 40)
) |>
mutate(
education = 5 + .2 * age + rnorm(n = n()),
earnings = -1800 +
120 * age -
1.1 * age^2 +
50 * education +
rnorm(n = n(), sd = 30)
) |>
mutate(education = factor(round(education)))
xy_distribution <-
data |>
ggplot() +
aes(x = age, y = earnings, color = education) +
geom_point() +
labs(
x = "Age",
y = "Earnings",
title = "Earnings Reported at Different Ages"
)
xy_distribution
model_one <- lm(earnings ~ age, data = data)
model_two <- lm(earnings ~ age + education, data = data)
model_three <- lm(earnings ~ age + I(age^2) + education, data = data)
summary(model_exploration2_qual)
summary(model_exploration2_qual)
