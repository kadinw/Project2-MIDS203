dat <- subset(filtered_occ_data, complete.cases(Quality.of.Sleep, Occupation))
dat$Occupation <- factor(dat$Occupation)
dat$Quality.of.Sleep <- as.numeric(as.character(dat$Quality.of.Sleep))
# Fit ANOVA
fit <- aov(Quality.of.Sleep ~ Occupation, data = dat)
summary(fit)        # F-test and p-value
TukeyHSD(fit)       # Post-hoc pairwise comparisons between occupations
# Effect size (eta-squared)
ss <- summary(fit)[[1]][, "Sum Sq"]
eta2 <- ss["Occupation"] / sum(ss)
eta2
